# Netlify environment variables: server-only, scope Functions.
# Only these email addresses may edit the site (comma-separated).
ADMIN_EMAILS=

# Fine-grained GitHub token for buranJ/alybaev only, Contents: Read and write.
# Never use NEXT_PUBLIC_ for this token or commit a filled .env file.
GITHUB_CONTENT_TOKEN=

# Netlify Identity service on the existing production site.
NETLIFY_IDENTITY_URL=https://alybaev.netlify.app/.netlify/identity
